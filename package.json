{
  "name": "fabulove-erp",
  "version": "1.0.0",
  "description": "Fabulove AI Seller Agent - ERP completo para automação de e-commerce",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/app.js",
    "dev:client": "vite client --config client/vite.config.js",
    "build": "vite build client --config client/vite.config.js",
    "preview": "vite preview client --config client/vite.config.js",
    "start": "node server/app.js",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "erp",
    "e-commerce",
    "ai",
    "automation",
    "marketplace"
  ],
  "author": "Fabulove",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.5.2",
    "@vitest/coverage-v8": "^1.6.0",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "pinia": "^2.1.7",
    "supertest": "^6.3.4",
    "vite": "^5.0.0",
    "vitest": "^1.6.0",
    "vue": "^3.3.11",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.2.5"
  }
}
