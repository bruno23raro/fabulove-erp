{
  "name": "sizren-erp",
  "version": "1.0.0",
  "description": "SIZEN ERP — ERP completo para automação de e-commerce",
  "main": "server/app.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon server/app.js",
    "dev:client": "vite client --config client/vite.config.js",
    "build": "vite build client --config client/vite.config.js",
    "preview": "vite preview client --config client/vite.config.js",
    "start": "node server/app.js",
    "lint": "eslint . --ext .js,.vue --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.vue --fix",
    "format": "prettier --write \"**/*.{js,vue,json,md}\" --ignore-path .prettierignore",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "db:backup": "node server/scripts/backup.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "erp",
    "e-commerce",
    "ai",
    "automation",
    "marketplace"
  ],
  "author": "Fabulove",
  "license": "MIT",
  "dependencies": {
    "@congminh1254/shopee-sdk": "^2.12.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.11.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.1.7",
    "papaparse": "^5.7.0",
    "pg": "^8.11.3",
    "resend": "^6.35.0",
    "shopee-api": "^1.0.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "xlsx": "^0.18.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@openapitools/openapi-generator-cli": "^2.42.0",
    "@playwright/test": "^1.64.1",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "axios": "^1.6.2",
    "chart.js": "^4.4.0",
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "nodemon": "^3.1.14",
    "pinia": "^2.1.7",
    "prettier": "^3.9.10",
    "supabase": "^2.123.0-beta.11",
    "supertest": "^6.3.4",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue": "^3.3.11",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.2.5"
  }
}
