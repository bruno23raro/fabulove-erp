# Configuração do Banco de Dados
# IMPORTANTE: Copie este arquivo para .env e preencha os valores
# NUNCA commite o arquivo .env no Git!

# Database
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fabulove_erp
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Server
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=sua_chave_jwt_super_secreta_aqui_128_chars_minimo

# APIs Externas (opcional)
OPENAI_API_KEY=sua_chave_openai_aqui
SHOPEE_API_KEY=sua_chave_shopee_aqui
MERCADOLIVRE_API_KEY=sua_chave_ml_aqui

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads