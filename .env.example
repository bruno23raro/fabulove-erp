# ============================================================================
# FABULOVE AI SELLER AGENT ERP — .env.example
# ============================================================================
# VALORES FICTÍCIOS — NÃO SÃO CREDENCIAIS REAIS.
# Copie para .env e substitua com valores reais do ambiente de produção.
# Nenhum segredo real está exposto neste arquivo.
# ============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------
# DATABASE (PostgreSQL)
# ------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fabulove_erp
DB_USER=postgres
DB_PASSWORD=admin

# ------------------------------------------------------------------
# JWT / AUTH
# ------------------------------------------------------------------
JWT_SECRET=trocar_por_um_segredo_forte_32_chaves_aleatorias_reais
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------
# EMAIL / SMTP (para recuperação de senha e notificações)
# ------------------------------------------------------------------
# BLOQUEIO EXTERNO DOCUMENTADO: credenciais SMTP não fornecidas nesta
# sessão. Quando disponíveis, configure SMTP_HOST, SMTP_PORT, SMTP_USER,
# SMTP_PASS, EMAIL_FROM e EMAIL_FROM_NAME abaixo.
SMTP_HOST=smtp.sendgrid.net          # ou smtp.gmail.com, smtp.mailgun.org, etc.
SMTP_PORT=587                        # 587 (TLS) ou 465 (SSL) ou 25 (sem criptografia)
SMTP_SECURE=false                    # true se usar porta 465 (SSL)
SMTP_USER=exemplo@seudominio.com     # usuário SMTP / API key
SMTP_PASS=senha_smtp_secreta_aqui     # senha / chave de API
EMAIL_FROM=noreply@fabulove.com      # endereço de envio
EMAIL_FROM_NAME=Fabulove AI Seller Agent

# ------------------------------------------------------------------
# MARKETPLACE INTEGRATIONS (bloqueio externo documentado)
# ------------------------------------------------------------------
# SHOPEE_API_KEY=...                  # chave de API Shopee — não disponível
# MERCADOLIVRE_API_KEY=...            # chave de API Mercado Livre — não disponível
# MERCADOLIVRE_ACCESS_TOKEN=...       # token de acesso Mercado Livre — não disponível

# ------------------------------------------------------------------
# AI / AUTOMATION (bloqueio externo documentado)
# ------------------------------------------------------------------
# OPENAI_API_KEY=sk-...               # chave OpenAI — não disponível

# ------------------------------------------------------------------
# LOGS / UPLOADS
# ------------------------------------------------------------------
LOG_DIR=./logs
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------
# CORS (ambientes permitidos — ajustar em produção)
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
