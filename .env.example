# ============================================================================
# SIZEN ERP — .env.example
# ============================================================================
# VALORES FICTÍCIOS — NÃO SÃO CREDENCIAIS REAIS.
# Copie para .env e substitua com valores reais do ambiente de produção.
# Nenhum segredo real está exposto neste arquivo.
# ============================================================================

NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------
# DATABASE (PostgreSQL / Supabase)
# ------------------------------------------------------------------
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sizren_erp
# DB_USER=postgres
# DB_PASSWORD=admin

# Ou use a URL completa (Supabase, Neon, etc.)
# DATABASE_URL=postgresql://postgres:admin@localhost:5432/sizren_erp

# ------------------------------------------------------------------
# JWT / AUTH
# ------------------------------------------------------------------
JWT_SECRET=trocar_por_um_segredo_forte_32_chaves_aleatorias_reais
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# ------------------------------------------------------------------
# EMAIL / SMTP
# ------------------------------------------------------------------
# Opção 1: Resend API (recomendado)
RESEND_API_KEY=re_...

# Opção 2: SMTP tradicional
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu_usuario
SMTP_PASS=sua_senha
EMAIL_FROM=noreply@sizen.com
EMAIL_FROM_NAME=SIZEN ERP

# ------------------------------------------------------------------
# AI PROVIDERS (OpenAI-compatible)
# ------------------------------------------------------------------
# OpenAI
# OPENAI_API_KEY=sk-...

# NVIDIA NIM
# NVIDIA_NIM_API_KEY=...
# NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Agnes AI (free key)
# AGNES_AI_API_KEY=...

# Provider ativo (openai, nvidia-nim, agnes-ai)
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_BASE_URL=

# ------------------------------------------------------------------
# CLIENTE
# ------------------------------------------------------------------
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------
# LOGS / UPLOADS
# ------------------------------------------------------------------
LOG_DIR=./logs
UPLOAD_DIR=./uploads

# ------------------------------------------------------------------
# CORS (ambientes permitidos — ajustar em produção)
# ------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
