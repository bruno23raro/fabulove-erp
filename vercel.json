{
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "server/app.js": {
      "maxDuration": 300
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "server/app.js" },
    { "src": "/static/(.*)", "dest": "client/dist/assets/$1" },
    { "src": "/(.*)", "dest": "client/dist/index.html" }
  ]
}